+// Pure reconstruction of Q1–Q7. Views are used only for Q6 comparisons.
+import assert from 'node:assert/strict';
+import { isDeepStrictEqual } from 'node:util';
+import { auditPricing, navCorrections } from './audit-pricing.mjs';
+import { applyReplayEvent, createReplayState, finalizeNavReferences, normalizedProjection } from '../replay-engine.mjs';
+
+const ZERO = `0x${'0'.repeat(40)}`;
+const UNIT = 10n ** 18n;
+export const actorNames = (spec) => Object.fromEntries(
+  Object.entries(spec.actors).map(([name, address]) => [address.toLowerCase(), name]));
+
+export function auditCase({ genesis, events, checkpoints, pricingPolicy, names }) {
+  const state = createReplayState(genesis);
+  const name = (address) => names[address.toLowerCase()] ?? address.toLowerCase();
+  const refs = []; const movements = []; const provenance = []; const delays = [];
+  const projections = new Map();
+  const suspension = { shareMovements: 0, redemptionRequests: 0, subscriptionRequests: 0, navVersions: 0 };
+  let suspended = false;
+  for (const event of events) {
+    const { eventName, args } = event;
+    if (eventName === 'Transfer') {
+      const from = args.from.toLowerCase(); const to = args.to.toLowerCase();
+      const kind = from === ZERO ? 'mint' : to === ZERO ? 'burn' : 'transfer';
+      const parties = kind === 'mint' ? [to] : kind === 'burn' ? [from] : [from, to];
+      movements.push({ kind, parties: parties.map(name), eligible: parties.every((p) => Boolean(state.whitelist[p])) });
+      if (suspended) suspension.shareMovements++;
+    }
+    if (suspended && eventName === 'RedemptionRequested') suspension.redemptionRequests++;
+    if (suspended && eventName === 'SubscriptionRequested') suspension.subscriptionRequests++;
+    if (suspended && eventName === 'NAVUpdatedEvent') suspension.navVersions++;
+    if (eventName === 'Paused') suspended = true;
+    if (eventName === 'Unpaused') suspended = false;
+    if (eventName === 'NAVUpdatedEvent') {
+      provenance.push({ index: state.navHistory.length, nav: String(args.nav), asOf: String(args.asOf),
+        by: name(args.by), payloadHash: args.payloadHash });
+    }
+    if (eventName === 'SettlementDelayed') {
+      delays.push({ requestId: String(args.requestId), investor: name(args.investor), reasonHash: args.reasonHash,
+        requestedAt: Number(args.requestedAt), delayedAt: Number(args.delayedAt) });
+    }
+    if (eventName === 'RedemptionSettled') {
+      for (const delay of delays.filter((d) => d.requestId === String(args.requestId))) {
+        delay.settlementLagSec = Number(args.settledAt) - delay.requestedAt;
+      }
+    }
+    refs.push(...applyReplayEvent(state, event));
+    projections.set(String(event.blockNumber), normalizedProjection(state));
+  }
+  const references = finalizeNavReferences(state, refs);
+  const corrections = navCorrections(state.navHistory);
+  provenance.forEach((nav) => { nav.correctionOf = corrections.correctionOf[nav.index]; });
+  const pricing = auditPricing(state, references, pricingPolicy).map((r) => ({ ...r, investor: name(r.investor) }));
+  const affected = references.filter((ref) => corrections.latestVersion[ref.latestRecoverableNavIndex] !== ref.latestRecoverableNavIndex)
+    .map((ref) => {
+      const redemption = ref.eventName === 'RedemptionSettled';
+      const request = (redemption ? state.redemptions : state.subscriptions)[Number(ref.requestId)];
+      const result = { event: ref.eventName, requestId: String(ref.requestId), navIndex: ref.latestRecoverableNavIndex,
+        nav: ref.referencedNav, investor: name(request.investor) };
+      if (redemption) {
+        const corrected = state.navHistory[corrections.latestVersion[result.navIndex]];
+        result.paidAmount = request.redemptionAmount;
+        result.amountAtCorrectedNav = (BigInt(request.redeemedShares) * BigInt(corrected.nav) / UNIT).toString();
+        result.overpayment = (BigInt(result.paidAmount) - BigInt(result.amountAtCorrectedNav)).toString();
+      }
+      return result;
+    });
+  const checkpointMatches = checkpoints.map((cp) => isDeepStrictEqual(projections.get(String(cp.block)), cp.view));
+  const answers = {
+    Q1: { matchingCasePolicy: pricing.filter((r) => r.nextApplicableNavMatches).length, total: pricing.length,
+      exceptions: pricing.filter((r) => !r.nextApplicableNavMatches),
+      originalProxyMatching: pricing.filter((r) => r.originalAsOfProxy).length, detail: pricing },
+    Q2: { affected },
+    Q3: { movements: movements.length, eligibleAtTime: movements.filter((r) => r.eligible).length, detail: movements },
+    Q4: suspension,
+    Q5: { versions: provenance.length, corrections: corrections.correctionIndices.length,
+      allWithSubmitterAndPayload: provenance.every((r) => r.by && /^0x[0-9a-f]{64}$/.test(r.payloadHash) && !/^0x0+$/.test(r.payloadHash)),
+      detail: provenance },
+    Q6: { matched: checkpointMatches.filter(Boolean).length, checkpoints: checkpoints.length },
+    Q7: { delayed: delays },
+  };
+  return { answers, state, references, corrections, checkpointMatches };
+}
+
+// Explicit selectors keep the post-review expectation file readable. Complete
+// arrays (not just counts) bind the affected set, movements and delay records.
+export function assertCaseExpectations(answers, spec) {
+  const checked = new Set();
+  for (const [selector, expected] of Object.entries(spec.expected)) {
+    const observed = selector.split('.').reduce((value, key) => value?.[key], answers);
+    assert.deepEqual(observed, expected, `Case expectation ${selector}`);
+    checked.add(selector.split('.')[0]);
+  }
+  assert.deepEqual([...checked].sort(), ['Q1', 'Q2', 'Q3', 'Q4', 'Q5', 'Q6', 'Q7'], 'Expected coverage Q1–Q7');
+  return Object.fromEntries([...checked].map((question) => [question, true]));
+}
+
+export function assertCaseAnswers(recomputed, archived) {
+  for (const question of ['Q1', 'Q2', 'Q3', 'Q4', 'Q5', 'Q6', 'Q7']) {
+    assert.deepEqual(recomputed[question], archived[question], `Archived case answer ${question}`);
+  }
+}
diff --git a/experiments/paper85-evaluation/scripts/v3/audit-case.test.mjs b/experiments/paper85-evaluation/scripts/v3/audit-case.test.mjs
new file mode 100644
index 0000000..4b5d49a
--- /dev/null
+++ b/experiments/paper85-evaluation/scripts/v3/audit-case.test.mjs
@@ -0,0 +1,105 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { spawnSync } from 'node:child_process';
+import { mkdtemp, readFile, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join, resolve } from 'node:path';
+import { gunzipSync } from 'node:zlib';
+import { actorNames, auditCase, assertCaseExpectations } from './audit-case.mjs';
+import { ROOT } from './evidence.mjs';
+import { verifyCase } from './verify-run.mjs';
+
+const folder = resolve(ROOT, 'docs/evidence/paper85/v3-revision/2026-10-20T01-15-00.607Z-f5edfdac');
+const input = JSON.parse(gunzipSync(await readFile(resolve(folder, 'case/replay.json.gz'))));
+const summary = JSON.parse(await readFile(resolve(folder, 'C-case-summary.json'), 'utf8'));
+const spec = JSON.parse(await readFile(resolve(ROOT,
+  'experiments/paper85-evaluation/spec-v3/case-expectations.postreview.json'), 'utf8'));
+const query = (events = input.decoded, checkpoints = [], pricingPolicy = { suspensions: input.pricingPolicy.suspensions }) =>
+  auditCase({ genesis: input.genesis, events, checkpoints, pricingPolicy, names: actorNames(spec) });
+
+test('all seven case queries reproduce the sealed answers and post-review expectations', () => {
+  const result = verifyCase(input, summary, spec);
+  assert.deepEqual(result.questions, ['Q1', 'Q2', 'Q3', 'Q4', 'Q5', 'Q6', 'Q7']);
+  assert.equal(result.affectedBusinesses, 1);
+});
+
+test('Q2 uses the last of multiple same-date corrections', () => {
+  const events = structuredClone(input.decoded);
+  const correction = events.findIndex((e) => e.eventName === 'NAVUpdatedEvent' && e.args.asOf !== e.args.storedAt);
+  const extra = structuredClone(events[correction]);
+  extra.args.nav = (BigInt(extra.args.nav) - 10n ** 16n).toString();
+  events.splice(correction + 1, 0, extra);
+  const result = query(events);
+  assert.deepEqual(result.corrections.correctionOf, [null, null, null, 2, 3, null]);
+  assert.equal(result.corrections.latestVersion[2], 4);
+  assert.equal(result.answers.Q2.affected[0].overpayment, (2000n * 10n ** 18n).toString());
+  assert.equal(result.answers.Q5.corrections, 2);
+});
+
+test('Q2 derives an empty affected set when no NAV is corrected', () => {
+  const events = input.decoded.filter((e) => e.eventName !== 'NAVUpdatedEvent' || e.args.asOf === e.args.storedAt);
+  assert.deepEqual(query(events).answers.Q2.affected, []);
+});
+
+test('Q3 checks eligibility at each movement, rather than using final eligibility', () => {
+  const events = structuredClone(input.decoded);
+  events.find((e) => e.eventName === 'InvestorWhitelisted' && e.args.investor.toLowerCase() === spec.actors.A).args.eligible = false;
+  const { Q3 } = query(events).answers;
+  assert.equal(Q3.movements, 6);
+  assert.equal(Q3.eligibleAtTime, 3);
+});
+
+test('Q4 counts only events inside actual pause/resume boundaries', () => {
+  const events = input.decoded.filter((e) => !['Paused', 'Unpaused'].includes(e.eventName));
+  assert.deepEqual(query(events).answers.Q4,
+    { shareMovements: 0, redemptionRequests: 0, subscriptionRequests: 0, navVersions: 0 });
+});
+
+test('Q5 detects a missing evidence payload', () => {
+  const events = structuredClone(input.decoded);
+  events.find((e) => e.eventName === 'NAVUpdatedEvent').args.payloadHash = `0x${'0'.repeat(64)}`;
+  assert.equal(query(events).answers.Q5.allWithSubmitterAndPayload, false);
+});
+
+test('Q6 recomputes projection matches against independently supplied checkpoints', () => {
+  const checkpoints = structuredClone(input.checkpoints);
+  checkpoints[0].view.totalSupply = '1';
+  assert.deepEqual(query(input.decoded, checkpoints).answers.Q6, { matched: 22, checkpoints: 23 });
+});
+
+test('Q7 derives the delay reason and exact duration from events', () => {
+  const { delayed } = query().answers.Q7;
+  assert.equal(delayed.length, 1);
+  assert.equal(delayed[0].investor, 'B');
+  assert.equal(delayed[0].settlementLagSec, 26.5 * 3600);
+  assert.equal(delayed[0].reasonHash, spec.expected['Q7.delayed'][0].reasonHash);
+});
+
+for (const question of ['Q2', 'Q3', 'Q4', 'Q5', 'Q6', 'Q7']) {
+  test(`verifier rejects an incorrect ${question} answer even when other summaries agree`, () => {
+    const corrupted = structuredClone(summary);
+    if (question === 'Q2') corrupted.answers.Q2.affected = [];
+    if (question === 'Q3') corrupted.answers.Q3.detail[0].eligible = false;
+    if (question === 'Q4') corrupted.answers.Q4.redemptionRequests = 0;
+    if (question === 'Q5') corrupted.answers.Q5.detail[3].correctionOf = null;
+    if (question === 'Q6') corrupted.answers.Q6.matched = 0;
+    if (question === 'Q7') corrupted.answers.Q7.delayed[0].settlementLagSec++;
+    assert.throws(() => verifyCase(input, corrupted, spec), new RegExp(`Archived case answer ${question}`));
+  });
+}
+
+test('machine-readable expectations are enforced independently of archived answers', () => {
+  const wrong = structuredClone(spec);
+  wrong.expected['Q2.affected'] = [];
+  assert.throws(() => assertCaseExpectations(query().answers, wrong), /Case expectation Q2/);
+});
+
+test('verification CLI refuses to place a report inside its input directory', async (t) => {
+  const temporary = await mkdtemp(join(tmpdir(), 'paper85-report-'));
+  t.after(() => rm(temporary, { recursive: true, force: true }));
+  const result = spawnSync(process.execPath,
+    [resolve(ROOT, 'experiments/paper85-evaluation/scripts/v3/verify-run.mjs'), temporary, join(temporary, 'report.json')],
+    { encoding: 'utf8' });
+  assert.notEqual(result.status, 0);
+  assert.match(result.stderr, /Report must be outside the sealed run/);
+});
